        <mxCell id="VIbkPc61aUxE3C_yBAuX-42" parent="VIbkPc61aUxE3C_yBAuX-61" style="rounded=1;whiteSpace=wrap;html=1;" value="Клик &quot;Сгенерировать&quot;" vertex="1">

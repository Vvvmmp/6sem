        <mxCell id="VIbkPc61aUxE3C_yBAuX-43" parent="VIbkPc61aUxE3C_yBAuX-61" style="rounded=1;whiteSpace=wrap;html=1;" value="Отработка санитайзера (очистка кода)" vertex="1">
          <mxGeometry height="60" width="120" x="50" y="150" as="geometry" />
        </mxCell>
        <mxCell id="VIbkPc61aUxE3C_yBAuX-44" parent="VIbkPc61aUxE3C_yBAuX-61" style="rounded=1;whiteSpace=wrap;html=1;" value="Резервный Regex-парсер таблиц" vertex="1">
          <mxGeometry height="60" width="120" x="210" y="150" as="geometry" />
        </mxCell>
        <mxCell id="VIbkPc61aUxE3C_yBAuX-45" parent="VIbkPc61aUxE3C_yBAuX-61" style="rounded=1;whiteSpace=wrap;html=1;" value="Просмотр диаграммы на холсте" vertex="1">
